# Copy to .env and adjust for your environment.
# Environment variables override config.json and config/person.json.

COUNTRY=United States
DEFAULT_PASSWORD=12345678
USERS_TO_GENERATE=100
ENVIRONMENT=production

SIGNUP_API_URL=https://adselect.net/api/auth/register
ALLOW_REMOTE_SIGNUP=true
SPONSOR=ASD5437949
SOURCE_URL=https://adselect.net/register?ref=ASD5437949

OUTPUT_DIR=output
LOG_LEVEL=INFO
DB_PATH=output/test_users.db
CSV_PATH=output/test_users.csv
JSON_PATH=output/test_users.json
RESULTS_PATH=output/signup_results.json

REQUEST_DELAY_SECONDS=2.0
REQUEST_MAX_RETRIES=2

BATCH_SIZE=10
BATCH_DELAY_SECONDS=20.0

# Optional: command to run when the server returns HTTP 429 (rate limited).
# It must actually change your public egress/IP for AdSelect to see a new network.
# Leave empty if using VPN rotation instead.
NETWORK_RESET_COMMAND=
NETWORK_RESET_WAIT_SECONDS=10
PREFLIGHT_BEFORE_SUBMIT=true
